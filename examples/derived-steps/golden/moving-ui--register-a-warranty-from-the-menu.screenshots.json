  "steps": [
    {
      "action": "Open http://127.0.0.1:4321/store",
      "moment": "after",
      "probes": []
    },
    {
      "action": "Click the **Menu** button",
      "moment": "action",
      "probes": [
        {
          "name": "outline",
          "at": "outline"
        },
        {
          "name": "hamburger button",
          "at": "inside",
          "dx": 3
        },
        {
          "name": "click dot",
          "at": "clickPoint"
        }
      ]
    },
    {
      "action": "Click the **Warranty** link",
      "moment": "action",
      "probes": [
        {
          "name": "outline",
          "at": "outline"
        },
        {
          "name": "slid-in menu link",
          "at": "inside",
          "dx": 6
        },
        {
          "name": "click dot",
          "at": "clickPoint"
        }
      ]
    },
    {
      "action": "Click the **Warranty** button",
      "moment": "action",
      "probes": [
        {
          "name": "outline",
          "at": "outline"
        },
        {
          "name": "accordion trigger",
          "at": "inside",
          "dx": -6
        },
        {
          "name": "click dot",
          "at": "clickPoint"
        }
      ]
    },
    {
      "action": "Type **SN-1234** into **Serial number**",
      "moment": "action",
      "probes": [
        {
          "name": "outline",
          "at": "outline"
        },
        {
          "name": "opened field",
          "at": "inside",
          "dx": 6
        },
        {
          "name": "no click dot",
          "at": "elementBoxCenter"
        }
      ]
    },
    {
      "action": "Press **Enter**",
      "moment": "action",
      "probes": []
    },
    {
      "action": "Click the **Menu** button",
      "moment": "action",
      "probes": [
        {
          "name": "outline on the sticky header",
          "at": "outline"
        },
        {
          "name": "hamburger button",
          "at": "inside",
          "dx": 3
        },
        {
          "name": "click dot",
          "at": "clickPoint"
        }
      ]
    }
