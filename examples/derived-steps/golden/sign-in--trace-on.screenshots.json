{
  "bundleDirs": [
    "trace-on/sign-in--sign-in-with-bad-credentials"
  ],
  "viewport": {
    "width": 800,
    "height": 600
  },
  "minBytes": 2000,
  "tolerance": 40,
  "steps": [
    {
      "action": "Open http://127.0.0.1:4321/",
      "moment": "after",
      "probes": [
        {
          "name": "home marker",
          "x": 400,
          "y": 140
        }
      ]
    },
    {
      "action": "Click the **Sign in** link",
      "byMoment": {
        "action": [
          {
            "name": "home marker",
            "x": 400,
            "y": 140
          },
          {
            "name": "click dot",
            "at": "clickPoint"
          }
        ],
        "after": [
          {
            "name": "login marker",
            "x": 400,
            "y": 140
          }
        ]
      }
    },
    {
      "action": "Type **demo-user** into **Username**",
      "moment": "after",
      "optional": true,
      "probes": [
        {
          "name": "login marker",
          "x": 400,
          "y": 140
        }
      ]
    },
    {
      "action": "Click the **Submit bad credentials** button",
      "byMoment": {
        "action": [
          {
            "name": "login marker",
            "x": 400,
            "y": 140
          },
          {
            "name": "click dot",
            "at": "clickPoint"
          }
        ],
        "after": [
          {
            "name": "Login failed page's error banner",
            "x": 400,
            "y": 140
          }
        ]
      }
    }
  ]
}
