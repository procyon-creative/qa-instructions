{
  "name": "qa-instructions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint:eslint": "eslint --no-warn-ignored",
    "lint:format": "prettier --check --ignore-unknown",
    "lint": "pnpm lint:eslint . && pnpm lint:format .",
    "format": "prettier --write .",
    "prepare": "husky",
    "example": "pnpm --filter @qa-instructions/example-basic test",
    "verify": "pnpm -r --workspace-concurrency=1 --filter './examples/*' e2e"
  },
  "lint-staged": {
    "*": [
      "pnpm lint:eslint",
      "pnpm lint:format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.0"
  }
}
