{
  "name": "qa-instructions-docs-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "GitHub Pages landing page for procyon-creative/qa-instructions. Built with Astro 5 + @procyon-creative/astro-theme. Not a pnpm workspace package: it has its own npm lockfile.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "test": "astro build && tsc --noEmit && node --test test/*.test.ts"
  },
  "dependencies": {
    "@procyon-creative/astro-theme": "^0.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.18.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
